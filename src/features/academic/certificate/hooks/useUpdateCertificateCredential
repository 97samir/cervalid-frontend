import { useMutation, useQueryClient } from "@tanstack/react-query";
import { certificateService } from "../services/certificateService";

export const useUpdateCertificateCredential = () => {

    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: certificateService.updateCertificateCredential,

        onSuccess: (_, variables) => {
            
            const certificatePublicId = variables.certificatePublicId;

            queryClient.invalidateQueries({
                queryKey: ["certificate", certificatePublicId],
            });

            queryClient.invalidateQueries({
                queryKey: ["certificate-detail", certificatePublicId],
            });

            queryClient.invalidateQueries({
                queryKey: ["student-certificates"],
            });

            queryClient.invalidateQueries({
                queryKey: ["student-timeline"],
            });
        },
    });
};
